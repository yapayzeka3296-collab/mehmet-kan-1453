# Shopier ile ödeme
# Her paket için Shopier hesabınızda oluşturduğunuz ödeme/ürün bağlantısını Vercel Environment Variables'a ekleyin.
# Gerçek bağlantıları bu dosyaya veya GitHub'a yazmayın.
VITE_SHOPIER_DIGITAL_LINK=
VITE_SHOPIER_ELITE_LINK=
VITE_SHOPIER_PREMIUM_LINK=

# Shopier webhook / API (sunucu tarafında tutulmalıdır; VITE_ ile başlamamalıdır)
SHOPIER_PERSONAL_ACCESS_TOKEN=
SHOPIER_WEBHOOK_SECRET=
SHOPIER_API_BASE_URL=https://api.shopier.com/v1
