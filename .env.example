# Browser-safe Supabase configuration for Vite/TanStack Start.
# In cPanel, add these under Application Manager > Environment Variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase configuration.
# NEVER expose SUPABASE_SERVICE_ROLE_KEY through VITE_ variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shopier server-side checkout configuration.
# This must be a real Shopier product/payment URL configured for your account.
# Never put Shopier credentials or tokens in VITE_ variables.
SHOPIER_CHECKOUT_URL=
