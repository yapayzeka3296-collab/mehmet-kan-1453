# MySkyParcel — cPanel / CloudLinux Passenger
# GitHub -> cPanel Git -> Nitro/Passenger -> public_html.
# Static assets and pre-rendered public pages are served by Apache/LiteSpeed;
# dynamic/SSR routes continue through Passenger.

PassengerAppRoot "/home/myskypar/repositories/mehmet-kan-1453"
PassengerBaseURI "/"
PassengerNodejs "/home/myskypar/nodevenv/repositories/mehmet-kan-1453/22/bin/node"
PassengerAppType node
PassengerStartupFile app.js
PassengerAppEnv production
PassengerEnabled on

Options -MultiViews
Options -Indexes
# Pre-rendered legal/contact routes are emitted as /route/index.html.
# Keep DirectoryIndex enabled so direct /route URLs resolve to that file.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never send Vite/Nitro static files through the SSR application.
  RewriteRule ^assets(?:/|$) - [L]

  # Existing public files/directories are served directly. DirectoryIndex
  # resolves pre-rendered route folders such as /kvkk/ to index.html.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/webp .webp
  AddType image/gif .gif
  AddType application/wasm .wasm
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType font/ttf .ttf
  AddType font/otf .otf
</IfModule>

<IfModule mod_headers.c>
  # Prevent stale bundles while the production deployment is being verified.
  <FilesMatch "\.(js|css|mjs|json|wasm|svg|png|jpg|jpeg|webp|gif|woff|woff2|ttf|otf)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>

  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule LiteSpeed>
  CacheLookup off
</IfModule>
