# MySkyParcel — cPanel / CloudLinux Passenger
# Passenger handles application routes; Apache/LiteSpeed serves real static files.

Options -MultiViews
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never send real files/directories to Passenger.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Missing assets must remain a normal 404, not become an application route.
  RewriteRule ^assets(?:/|$) - [R=404,L]
</IfModule>

<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/webp .webp
  AddType image/gif .gif
  AddType application/wasm .wasm
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType font/ttf .ttf
  AddType font/otf .otf
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|json|wasm|woff|woff2|ttf|otf|svg|png|jpg|jpeg|webp|gif)$">
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
  <FilesMatch "\.(css|js|mjs|woff|woff2|ttf|otf|svg|png|jpg|jpeg|webp|gif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
