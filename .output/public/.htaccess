# MySkyParcel — cPanel / CloudLinux Passenger
# GitHub -> cPanel Git -> Nitro/Passenger -> public_html.
# Static assets are served by Apache/LiteSpeed; SSR routes are handled by Passenger.

PassengerAppRoot "/home/myskypar/repositories/mehmet-kan-1453"
PassengerBaseURI "/"
PassengerNodejs "/home/myskypar/nodevenv/repositories/mehmet-kan-1453/22/bin/node"
PassengerAppType node
PassengerStartupFile app.js
PassengerAppEnv production
PassengerEnabled on

Options -MultiViews
Options -Indexes
DirectoryIndex disabled

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never send Vite/Nitro static files through the SSR application.
  RewriteRule ^assets(?:/|$) - [L]

  # Existing public files/directories are served directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/webp .webp
  AddType image/gif .gif
  AddType application/wasm .wasm
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType font/ttf .ttf
  AddType font/otf .otf
</IfModule>

<IfModule mod_headers.c>
  # During the cPanel repair, do not let LiteSpeed/Apache or a desktop browser
  # reuse an old JS/CSS response. The next deployment can safely re-enable
  # long-lived caching after the production bundle is verified.
  <FilesMatch "\.(js|css|mjs|json|wasm|svg|png|jpg|jpeg|webp|gif|woff|woff2|ttf|otf)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>

  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# LiteSpeed can keep a public cache independently of browser Cache-Control.
# Disable that cache for this application while the desktop stale-build issue
# is eliminated. This does not disable Passenger or static file serving.
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>
