# MySkyParcel — cPanel / CloudLinux Passenger
# GitHub -> cPanel Git -> Nitro/Passenger -> public_html.
# Static assets are served directly by Apache/LiteSpeed.
# All non-static requests are left for the enabled Passenger/Nitro application.

PassengerAppRoot "/home/myskypar/repositories/mehmet-kan-1453"
PassengerBaseURI "/"
PassengerNodejs "/home/myskypar/nodevenv/repositories/mehmet-kan-1453/22/bin/node"
PassengerAppType node
PassengerStartupFile app.js
PassengerAppEnv production
PassengerEnabled on

Options -MultiViews
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Static files must stay in Apache/LiteSpeed and must never be sent to Nitro.
  RewriteRule ^(?:assets/|.*\.(?:js|mjs|css|png|jpe?g|webp|gif|svg|ico|woff2?|ttf|otf|wasm|json|txt|xml|map|webmanifest|pdf))$ - [L,NC]

  # Existing physical static files are served directly.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Every non-static route (including direct navigation/F5) is handled by
  # Passenger, which starts app.js and serves the Nitro SSR application.
  # The '-' substitution preserves the original URL; Passenger remains the
  # request handler because PassengerEnabled is on for this application root.
  RewriteRule ^ - [L]
</IfModule>

<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/webp .webp
  AddType image/gif .gif
  AddType application/wasm .wasm
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType font/ttf .ttf
  AddType font/otf .otf
</IfModule>

<IfModule mod_headers.c>
  # Do not let a previous deployment's HTML/assets mask the new build.
  <FilesMatch "\.(js|css|mjs|json|wasm|svg|png|jpg|jpeg|webp|gif|woff|woff2|ttf|otf)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>

  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule LiteSpeed>
  CacheLookup off
</IfModule>
