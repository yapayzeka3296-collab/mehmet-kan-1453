# MySkyParcel — cPanel / CloudLinux Passenger
# Passenger handles SSR/HTML routes. Apache/LiteSpeed serves real frontend
# assets from public_html directly.

PassengerAppRoot "/home/myskypar/repositories/mehmet-kan-1453"
PassengerBaseURI "/"
PassengerNodejs "/home/myskypar/nodevenv/repositories/mehmet-kan-1453/22/bin/node"
PassengerAppType node
PassengerStartupFile app.js
PassengerAppEnv production
PassengerEnabled on

Options -MultiViews
Options -Indexes
DirectoryIndex disabled

# Explicit MIME types prevent JS/CSS from being returned as text/html.
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType application/wasm .wasm
  AddType font/woff .woff
  AddType font/woff2 .woff2
</IfModule>

# Do not rewrite real assets to index.html. Existing files are served by
# Apache/LiteSpeed; missing application routes fall through to Passenger/Nitro.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|wasm|woff|woff2|svg)$">
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
